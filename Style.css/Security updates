/* =====================================
   APP LOCK SCREEN
===================================== */


#app-lock-screen{

    position:fixed;

    top:0;

    left:0;

    width:100%;

    height:100%;

    background:#075e54;

    display:flex;

    justify-content:center;

    align-items:center;

    z-index:9999;

}



.lock-card{

    width:350px;

    background:white;

    padding:35px;

    border-radius:25px;

    text-align:center;

    box-shadow:
    0 20px 50px rgba(0,0,0,.3);

}



.lock-card img{

    width:100px;

    height:100px;

    border-radius:50%;

    object-fit:cover;

    margin-bottom:20px;

}



.lock-card h2{

    color:#075e54;

    margin-bottom:10px;

}



.lock-card p{

    color:#777;

    margin-bottom:20px;

}



.lock-card input{

    width:100%;

    padding:15px;

    border-radius:25px;

    border:1px solid #ccc;

    text-align:center;

    font-size:20px;

    letter-spacing:5px;

    margin-bottom:15px;

}



.lock-card button{

    width:100%;

}
