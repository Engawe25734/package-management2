# UPDATE BIO
# =====================================


def update_profile_bio(

    user_id,

    bio

):


    conn = get_connection()

    cursor = conn.cursor()



    cursor.execute(

    """

    UPDATE users

    SET bio=?

    WHERE id=?

    """,

    (

        bio,

        user_id

    )

    )



    conn.commit()

    conn.close()
