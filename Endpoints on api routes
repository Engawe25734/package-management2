# UPDATE PRIVACY SETTINGS
# =====================================


@router.put("/profile/{username}/privacy")
def update_privacy(

    username:str,

    settings:dict = Body(...)

):


    user = get_user_by_username(

        username

    )


    if not user:


        raise HTTPException(

            status_code=404,

            detail="User not found"

        )



    update_privacy_settings(

        user["id"],

        settings

    )



    return {


        "status":"privacy updated"

    }
