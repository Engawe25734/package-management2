/* =====================================
   SETTINGS PANEL
===================================== */


.settings-panel{

    position:fixed;

    top:0;

    right:0;

    width:350px;

    height:100%;

    background:white;

    z-index:1000;

    box-shadow:-5px 0 20px rgba(0,0,0,0.2);

    overflow-y:auto;

    transition:0.3s;

}





.hidden{

    display:none;

}





.settings-header{

    display:flex;

    justify-content:space-between;

    align-items:center;

    padding:20px;

    border-bottom:1px solid #ddd;

}





.settings-header h2{

    margin:0;

}





.settings-header button{

    border:none;

    background:none;

    font-size:20px;

    cursor:pointer;

}






/* =====================================
   SETTINGS PROFILE
===================================== */


.settings-profile{

    text-align:center;

    padding:25px;

}





.settings-profile img{

    width:100px;

    height:100px;

    border-radius:50%;

    object-fit:cover;

    border:3px solid #ddd;

}





.settings-profile h3{

    margin-top:15px;

    margin-bottom:5px;

}





.settings-profile p{

    color:#777;

}






.profile-upload{

    display:inline-block;

    margin-top:15px;

    padding:10px 15px;

    background:#25D366;

    color:white;

    border-radius:8px;

    cursor:pointer;

}






/* =====================================
   SETTINGS MENU
===================================== */


.settings-list{

    padding:15px;

}





.settings-list button{

    width:100%;

    padding:15px;

    margin-bottom:10px;

    border:none;

    background:#f5f5f5;

    border-radius:10px;

    text-align:left;

    font-size:16px;

    cursor:pointer;

}





.settings-list button:hover{

    background:#e8e8e8;

}







/* =====================================
   SETTINGS PAGES
===================================== */


.settings-page{

    position:fixed;

    top:0;

    right:0;

    width:350px;

    height:100%;

    background:white;

    z-index:1100;

    padding:25px;

    overflow-y:auto;

}






.settings-page h2{

    margin-bottom:25px;

}






.settings-page label{

    display:block;

    margin-top:15px;

    margin-bottom:5px;

    font-weight:500;

}





.settings-page input[type="text"],

.settings-page textarea,

.settings-page select{

    width:100%;

    padding:12px;

    border:1px solid #ccc;

    border-radius:8px;

}







/* =====================================
   PROFILE EDIT
===================================== */


#edit-avatar{

    width:120px;

    height:120px;

    border-radius:50%;

    object-fit:cover;

    display:block;

    margin:auto;

}






.profile-section{

    text-align:center;

    margin-bottom:25px;

}






/* =====================================
   CHECKBOX SWITCH STYLE
===================================== */


.settings-page input[type="checkbox"]{

    width:20px;

    height:20px;

    cursor:pointer;

}





/* =====================================
   BUTTONS
===================================== */


.primary-btn{

    width:100%;

    padding:14px;

    margin-top:20px;

    border:none;

    border-radius:10px;

    background:#25D366;

    color:white;

    font-size:16px;

    cursor:pointer;

}





.primary-btn:hover{

    opacity:0.9;

}






/* =====================================
   DARK MODE SUPPORT
===================================== */


body.dark-mode{

    background:#111;

    color:white;

}





body.dark-mode .settings-panel,

body.dark-mode .settings-page{

    background:#1f1f1f;

    color:white;

}





body.dark-mode .settings-list button{

    background:#333;

    color:white;

}





body.dark-mode input,

body.dark-mode textarea,

body.dark-mode select{

    background:#333;

    color:white;

    border-color:#555;

}







/* =====================================
   MOBILE RESPONSIVE
===================================== */


@media(max-width:600px){


    .settings-panel,

    .settings-page{

        width:100%;

    }


}
