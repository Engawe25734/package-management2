/* =====================================
   SETTINGS BUTTON
===================================== */

.settings-btn{

    width:45px;

    height:45px;

    border-radius:50%;

    background:#075e54;

    color:white;

    font-size:20px;

    display:flex;

    justify-content:center;

    align-items:center;

    cursor:pointer;

    transition:.3s;

}

.settings-btn:hover{

    background:#128c7e;

    transform:scale(1.05);

}
