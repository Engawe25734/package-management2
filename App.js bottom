// =====================================
// SAVE APPEARANCE
// =====================================

function saveAppearance(){


    const dark =

    document
    .getElementById("dark-mode")
    .checked;



    if(dark){


        document
        .body
        .classList
        .add("dark-mode");


    }

    else{


        document
        .body
        .classList
        .remove("dark-mode");


    }



    localStorage.setItem(

        "theme",

        dark ? "dark" : "light"

    );


}






// =====================================
// LOGOUT
// =====================================

function logout(){


    localStorage.removeItem(

        "token"

    );


    localStorage.removeItem(

        "username"

    );



    window.location.reload();


}
