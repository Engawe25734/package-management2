def update_user_pin(user_id, pin_hash):

    connection = get_connection()
    cursor = connection.cursor()

    cursor.execute(
        """
        UPDATE users
        SET pin_hash=?
        WHERE id=?
        """,
        (pin_hash, user_id)
    )

    connection.commit()
    connection.close()


def enable_app_lock(user_id, enabled):

    connection = get_connection()
    cursor = connection.cursor()

    cursor.execute(
        """
        UPDATE users
        SET app_lock=?
        WHERE id=?
        """,
        (1 if enabled else 0, user_id)
    )

    connection.commit()
    connection.close()


def get_user_pin(user_id):

    connection = get_connection()
    cursor = connection.cursor()

    cursor.execute(
        """
        SELECT pin_hash, app_lock
        FROM users
        WHERE id=?
        """,
        (user_id,)
    )

    row = cursor.fetchone()
    connection.close()

    return row

