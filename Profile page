<div
id="profile-page"
class="settings-page hidden">

<h2>

My Profile

</h2>

<div class="profile-section">

<img

id="edit-avatar"

src="/static/default-avatar.png">

</div>

<div class="input-group">

<label>

Username

</label>

<input

id="edit-username"

type="text">

</div>

<div class="input-group">

<label>

Bio

</label>

<textarea

id="edit-bio"

rows="4">

</textarea>

</div>

<button
class="primary-btn"
onclick="saveProfile()">

Save Changes

</button>

</div>
