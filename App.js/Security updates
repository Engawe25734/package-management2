Step 2 — Add automatic login restore in app.js

Place near the top of app.js after your variables:
// =====================================
// RESTORE USER SESSION
// =====================================

function restoreSession(){


    const savedToken =
    localStorage.getItem(
        "chatme_token"
    );


    const savedUsername =
    localStorage.getItem(
        "chatme_username"
    );



    if(savedToken && savedUsername){


        token = savedToken;

        username = savedUsername;


        openChat();


    }

}


window.onload = restoreSession;
